import os
import matplotlib as mpl
import matplotlib.pyplot as plt
import pandas as pd

# Matplotlib ayarları
if "font.enable_last_resort" in mpl.rcParams:
  mpl.rcParams["font.enable_last_resort"] = False

mpl.rcParams["font.sans-serif"] = [
    "Segoe UI",
    "Arial",
    "DejaVu Sans",
    "Calibri",
]
mpl.rcParams["font.family"] = "sans-serif"
mpl.rcParams["axes.unicode_minus"] = False

# Dosya yolunu belirleme
user_home = os.path.expanduser("~")
file_path = "HE10_ERA5Land_Aylik_1981_2025.csv"
if not os.path.exists(file_path):
  file_path = os.path.join(
      user_home, "Downloads", "HE10_ERA5Land_Aylik_1981_2025.csv"
  )

# Veriyi okuma ve aylık ortalama hesaplama
df_era5 = pd.read_csv(file_path)
t_clim = df_era5.groupby("Ay")["Sicaklik_C"].mean().reset_index()

aylar = [
    "Ocak",
    "Şubat",
    "Mart",
    "Nisan",
    "Mayıs",
    "Haziran",
    "Temmuz",
    "Ağustos",
    "Eylül",
    "Ekim",
    "Kasım",
    "Aralık",
]
t_clim["Ay_Adi"] = aylar

# Çizim
fig, ax = plt.subplots(figsize=(10, 5.5), dpi=300)

# Sade çizgi grafiği
ax.plot(
    t_clim["Ay_Adi"],
    t_clim["Sicaklik_C"],
    color="#d9534f",
    marker="o",
    linewidth=2.5,
    markersize=8,
    label="Aylık Ortalama Sıcaklık",
)

# Değer etiketleri
for _, row in t_clim.iterrows():
  val = row["Sicaklik_C"]
  offset = 12 if val >= 0 else -20
  ax.annotate(
      f"{val:.2f} °C",
      xy=(row["Ay_Adi"], val),
      xytext=(0, offset),
      textcoords="offset points",
      ha="center",
      va="bottom",
      fontsize=9,
      fontweight="bold",
      color="#333333",
  )

# 0 °C referans çizgisi
ax.axhline(0, color="gray", linestyle=":", alpha=0.7, linewidth=1.2)

ax.set_title(
    "Orlovac HES Memba Havzası 2 m Sıcaklık (T) Klimatolojisi (1981–2025)",
    fontsize=12,
    fontweight="bold",
    pad=15,
    color="#1f4e78",
)
ax.set_xlabel("Aylar", fontsize=11, fontweight="bold", labelpad=10)
ax.set_ylabel("Sıcaklık T (°C)", fontsize=11, fontweight="bold", labelpad=10)

ax.grid(True, linestyle="--", alpha=0.5, zorder=0)
ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)

ax.legend(
    loc="upper left",
    frameon=True,
    facecolor="white",
    framealpha=0.9,
    fontsize=9.5,
)

plt.ylim(min(t_clim["Sicaklik_C"]) - 4, max(t_clim["Sicaklik_C"]) + 5)
plt.tight_layout()

plt.savefig("Sicaklik_T_Klimatoloji_Sade.png", bbox_inches="tight", dpi=300)
plt.show()
